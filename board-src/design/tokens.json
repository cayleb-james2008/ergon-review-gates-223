  "opacity": {
    "disabled": "0.5",
    "drag": "0.9",
    "rule": "dimming is tone and muted text, never opacity; opacity is for disabled and drag only"
  },
  "radius": {
    "badge": "4px",
    "control": "6px",
    "card": "8px",
    "panel": "12px",
    "float": "14px",
    "rule": "inner radius = outer radius minus padding"
  },
  "space": {
    "scale": [
      "4px",
      "8px",
      "12px",
      "16px",
      "24px",
      "32px"
    ],
    "rule": "every padding, margin and gap sits on the 4px grid"
  },
  "type": {
    "family": "Geist Variable (self-hosted), fallback Geist Fallback",
    "scale": {
      "label": "12px",
      "body-sm": "14px",
      "body": "16px",
      "title": "18px",
      "marker": "22px"
    },
    "lineHeight": {
      "ui": 1.5,
      "body": 1.5,
      "heading": 1.1,
      "card": 1.1,
      "badge": 1
    },
    "fluid": "--fs 14px (16px at 1000px screen height or more) for note, initials and status; --fs-title 16px (18px at 1000px or more) for the customer; --fs-compact 12px for the compact card (every screen size); 11px and 12px on paper; steps only, no fractions",
    "weights": [
      400,
      500,
      600
    ],
    "roles": {
      "primary": "ink",
      "secondary": "muted",
      "accent": "accent-text"
    }
  },
  "motion": {
    "tap": "120ms",
    "swap": "200ms",
    "enter": "250ms",
    "sheet": "350ms",
    "ease": "cubic-bezier(0.23, 1, 0.32, 1)",
    "rule": "state change, press feedback, and floating-layer fade only; nothing moves on a keyboard open"
  }
}
