# Names only. Never put values in this file. Values are entered by the owner in Vercel / a local .env.
# The publishable (anon) key is public by design; it is safe only because row-level security is on every table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "supabase" (default) or "demo" (in-browser TEST data, no network, for previews and tests)
VITE_BACKEND=supabase
